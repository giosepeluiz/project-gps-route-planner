# Copie para .env.local e preencha. Nunca faça commit de chaves reais.

# --- Tempo e rota ---
# TomTom: matriz com trânsito, rota final e geocodificação reserva.
# Plano gratuito: 2.500 requisições de matriz por mês (veja o README).
TOMTOM_API_KEY=
# HERE: DESLIGADA por padrão. Só entra na cadeia (depois da TomTom) com HERE_ENABLED=1.
# Chave de API do HERE Platform (Matrix Routing API v8). Fica só no servidor.
HERE_API_KEY=
# HERE_ENABLED=1
# Google Maps Platform (Routes API): PRINCIPAL para matriz e rota com trânsito; a TomTom assume
# quando a cota do Google acaba. Chave de SERVIDOR: restrinja-a à Routes API e, no Google Cloud,
# limite a cota diária ao grátis (veja o README).
GOOGLE_MAPS_API_KEY=
# Trava de cota do app (opcional): limite mensal de cada serviço; o padrão é 90% da cota grátis.
# 0 desliga o serviço. QUOTA_TOMTOM e QUOTA_HERE contam pedidos/células; QUOTA_GOOGLE conta elementos.
# QUOTA_TOMTOM=2250
# QUOTA_TOMTOM_ROTA=18000
# QUOTA_HERE=2250
# QUOTA_GOOGLE=4500
# QUOTA_GOOGLE_ROTA=4500
# HERE_COUNT=element   # ou "request", depois de confirmar no painel da HERE como a matriz é contada
# OpenRouteService: último recurso, sem trânsito (opcional).
ORS_API_KEY=

# --- Geocodificação (fase 2) ---
# Identificação exigida pelo Nominatim, com um contato real.
NOMINATIM_USER_AGENT="rotas-pessoal (seu-contato@exemplo.com)"

# --- IA (opcional) ---
# Primária: Gemini Flash-Lite (Google AI Studio). Backup: Groq (gpt-oss-120b).
# Sem nenhuma chave, o site funciona só com o algoritmo local.
GEMINI_API_KEY=
GROQ_API_KEY=
# Modelos (os nomes mudam com frequência; confira na documentação antes de trocar).
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_MODEL=openai/gpt-oss-120b

# --- Mapa ---
# Estilo reserva, usado se o OpenFreeMap falhar. Opcional.
# Esta chave é baixada pelo navegador: restrinja-a por domínio no painel do MapTiler.
MAPTILER_KEY=
# Alternativa: URL completa de qualquer estilo MapLibre (tem prioridade sobre MAPTILER_KEY).
MAP_FALLBACK_STYLE_URL=

# --- Proteção das cotas ---
# Limite de requisições por IP nas rotas /api, por minuto (padrão: 60).
RATE_LIMIT_PER_MIN=

# --- Cache compartilhado (opcional; sem isso o cache fica em memória) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Estatísticas anônimas da viagem (opcional) ---
# Envio por e-mail pela Resend (https://resend.com). Sem as duas variáveis, a
# pergunta de envio nem aparece. O remetente precisa ser de um domínio verificado
# na Resend (registros DNS SPF/DKIM do domínio).
RESEND_API_KEY=
REPORT_EMAIL_FROM="Planejador de Rotas <rotas@arqueirover.de>"
# Destino (padrão: rotas@arqueirover.de).
REPORT_EMAIL_TO=
