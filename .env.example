# Copie para .env.local e preencha. Nunca faça commit de chaves reais.

# --- Tempo e rota ---
# TomTom: matriz com trânsito, rota final e geocodificação reserva.
# Plano gratuito: 2.500 requisições de matriz por mês (veja o README).
TOMTOM_API_KEY=
# OpenRouteService: reserva sem trânsito (opcional).
ORS_API_KEY=

# --- Geocodificação (fase 2) ---
# Identificação exigida pelo Nominatim, com um contato real.
NOMINATIM_USER_AGENT="rotas-pessoal (seu-contato@exemplo.com)"

# --- IA (opcional) ---
# Primária: Gemini Flash-Lite (Google AI Studio). Backup: Groq (gpt-oss-120b).
# Sem nenhuma chave, o site funciona só com o algoritmo local.
GEMINI_API_KEY=
GROQ_API_KEY=
# Modelos (os nomes mudam com frequência; confira na documentação antes de trocar).
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_MODEL=openai/gpt-oss-120b

# --- Mapa ---
# Estilo reserva, usado se o OpenFreeMap falhar. Opcional.
# Esta chave é baixada pelo navegador: restrinja-a por domínio no painel do MapTiler.
MAPTILER_KEY=
# Alternativa: URL completa de qualquer estilo MapLibre (tem prioridade sobre MAPTILER_KEY).
MAP_FALLBACK_STYLE_URL=

# --- Proteção das cotas ---
# Limite de requisições por IP nas rotas /api, por minuto (padrão: 60).
RATE_LIMIT_PER_MIN=

# --- Cache compartilhado (opcional; sem isso o cache fica em memória) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
